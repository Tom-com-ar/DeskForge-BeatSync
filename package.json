{
  "name": "deskforge-beatsync",
  "version": "1.0.1",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build": "vite build",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "loudness": "^0.4.2"
  },
  "build": {
    "appId": "com.deskforge.beatsync",
    "productName": "DeskForge + BeatSync",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
